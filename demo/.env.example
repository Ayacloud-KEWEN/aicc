# ---- Network ----
# STUN server(s), comma-separated. Leave empty on a Raspberry Pi reached over Tailscale/LAN
# (faster call setup); keep the default for calls across the public internet.
STUN_URLS=stun:stun.l.google.com:19302
# HOST=127.0.0.1
# PORT=7860        # local default; the Raspberry Pi service uses 10050 (set by deploy/setup_pi.sh)

# ---- Online payment ----
# pickup = pay at the counter only (default); stripe = offer "pay now" with Stripe Checkout.
PAYMENT_MODE=pickup
# Stripe TEST secret key (sk_test_...) from dashboard.stripe.com -> Developers -> API keys (Test mode).
STRIPE_SECRET_KEY=

# ---- Provider selection ----
# STT: azure | deepgram     TTS: azure | elevenlabs     LLM: deepseek | anthropic
STT_PROVIDER=azure
TTS_PROVIDER=azure
LLM_PROVIDER=deepseek

# ---- Azure Speech (STT + TTS) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
# Optional voice overrides
# AZURE_VOICE_FR=fr-FR-DeniseNeural
# AZURE_VOICE_EN=en-US-JennyNeural
# AZURE_VOICE_ZH=zh-CN-XiaoxiaoNeural

# ---- DeepSeek (LLM) ----
DEEPSEEK_API_KEY=
# Optional: leave empty to use Pipecat's default DeepSeek model
# DEEPSEEK_MODEL=

# ---- Alternatives (optional) ----
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
